NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Powers the "Dunyo bo'ylab" world map (Mapbox GL JS). Free account at mapbox.com —
# use a public token (starts with "pk."), never a secret one, since this ships to
# the browser. Free tier covers 50,000 map loads/month.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token
