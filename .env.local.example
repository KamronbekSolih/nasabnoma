NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Telegram sign-in. Leave unset until the Custom OIDC provider actually exists
# in the Supabase dashboard — the button is hidden while this is empty, rather
# than showing a control that fails with "provider is not enabled".
#
# Value is the provider slug you chose, with a "custom:" prefix.
# Setup, in this order:
#   1. BotFather -> your bot -> Login Widget: register the callback URL that
#      Supabase shows you (https://<project-ref>.supabase.co/auth/v1/callback),
#      and copy the Client ID + Secret.
#   2. Supabase -> Authentication -> Providers -> Custom OAuth Providers -> add
#      an OIDC provider: issuer https://oauth.telegram.org, those credentials,
#      scopes "openid profile", and email_optional enabled (Telegram never
#      returns an email address).
#   3. Supabase -> Authentication -> URL Configuration: add
#      https://your-site/auth/callback and http://localhost:3000/auth/callback
#      to the redirect allow-list.
# NEXT_PUBLIC_TELEGRAM_PROVIDER=custom:telegram

# The "Dunyo bo'ylab" world map (react-globe.gl + a bundled Natural Earth
# boundaries file) is fully self-contained — no account, no key, no env var.
